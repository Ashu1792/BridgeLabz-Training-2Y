import java.util.Scanner;

public class TrimWithoutTrim {

    static int[] findTrimIndexes(String text) {
        int start = 0;
        int end = text.length() - 1;

        while (start <= end && text.charAt(start) == ' ') start++;
        while (end >= start && text.charAt(end) == ' ') end--;

        return new int[]{start, end + 1};
    }

    static String substringUsingCharAt(String text, int start, int end) {
        String res = "";
        for (int i = start; i < end; i++) {
            res += text.charAt(i);
        }
        return res;
    }

    static boolean compareUsingCharAt(String a, String b) {
        if (a.length() != b.length()) return false;
        for (int i = 0; i < a.length(); i++) {
            if (a.charAt(i) != b.charAt(i)) return false;
        }
        return true;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        System.out.print("Enter text with spaces: ");
        String text = sc.nextLine();

        int[] idx = findTrimIndexes(text);
        String userTrim = substringUsingCharAt(text, idx[0], idx[1]);

        String builtTrim = text.trim();

        System.out.println("User-defined trim: [" + userTrim + "]");
        System.out.println("Built-in trim:     [" + builtTrim + "]");
        System.out.println("Both same? " + compareUsingCharAt(userTrim, builtTrim));

        sc.close();
    }
}
