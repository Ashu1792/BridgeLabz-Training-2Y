import java.util.Scanner;

public class CharTypeTable {

    static String checkCharType(char ch) {
        if (ch >= 'A' && ch <= 'Z') ch = (char)(ch + 32);

        if (ch < 'a' || ch > 'z') return "Not a Letter";

        if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') return "Vowel";
        return "Consonant";
    }

    static String[][] charType2D(String text) {
        String[][] arr = new String[text.length()][2];

        for (int i = 0; i < text.length(); i++) {
            arr[i][0] = String.valueOf(text.charAt(i));
            arr[i][1] = checkCharType(text.charAt(i));
        }
        return arr;
    }

    static void display2D(String[][] arr) {
        System.out.printf("%-10s %-15s\n", "Char", "Type");
        System.out.println("------------------------");
        for (int i = 0; i < arr.length; i++) {
            System.out.printf("%-10s %-15s\n", arr[i][0], arr[i][1]);
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        System.out.print("Enter text: ");
        String text = sc.nextLine();

        String[][] result = charType2D(text);
        display2D(result);

        sc.close();
    }
}
