import java.util.Scanner;

public class UpperCaseConvert {

    static String convertToUpperUsingCharAt(String text) {
        String result = "";

        for (int i = 0; i < text.length(); i++) {
            char ch = text.charAt(i);

            if (ch >= 'a' && ch <= 'z') {
                ch = (char) (ch - 32);
            }
            result += ch;
        }
        return result;
    }

    static boolean compareUsingCharAt(String a, String b) {
        if (a.length() != b.length()) return false;
        for (int i = 0; i < a.length(); i++) {
            if (a.charAt(i) != b.charAt(i)) return false;
        }
        return true;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter complete text: ");
        String text = sc.nextLine();

        String userUpper = convertToUpperUsingCharAt(text);
        String builtInUpper = text.toUpperCase();

        System.out.println("User Uppercase: " + userUpper);
        System.out.println("Built-in Uppercase: " + builtInUpper);

        System.out.println("Both same? " + compareUsingCharAt(userUpper, builtInUpper));

        sc.close();
    }
}
