import java.util.Scanner;

public class CharArrayCompare {

    static char[] getCharsWithoutToCharArray(String text) {
        char[] arr = new char[text.length()];
        for (int i = 0; i < text.length(); i++) {
            arr[i] = text.charAt(i);
        }
        return arr;
    }

    static boolean compareCharArrays(char[] a, char[] b) {
        if (a.length != b.length) return false;
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) return false;
        }
        return true;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter text: ");
        String text = sc.next();

        char[] userArr = getCharsWithoutToCharArray(text);
        char[] builtInArr = text.toCharArray();

        System.out.println("User-defined array: " + new String(userArr));
        System.out.println("Built-in array: " + new String(builtInArr));

        System.out.println("Both arrays same? " + compareCharArrays(userArr, builtInArr));

        sc.close();
    }
}
